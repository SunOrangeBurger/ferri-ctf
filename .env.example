# --- Required ---
# HMAC key for every stored flag and session. Min 32 bytes. IMMUTABLE once challenges exist.
SERVER_SECRET=change-me-min-32-bytes
# Bootstrap account (college ID). This becomes the Ferris account on first boot only.
ADMIN_USERNAME=your-college-id
ADMIN_PASSWORD=change-me
DATABASE_URL=sqlite://ferrisctf.db?mode=rwc

# --- Server ---
BIND_ADDR=0.0.0.0:8080
# Must be false while serving plain HTTP on the college Wi-Fi, or login will fail.
COOKIE_SECURE=false
RUST_LOG=info,ferrisctf=debug

# --- Optional overrides (defaults shown, see spec section 3) ---
# POOL_SIZE_PER_TEAM=15
# PLANNED_QUESTIONS=60
# ROUND_COUNT=4
# REPEAT_PENALTY_POINTS=10
# GRACE_PERIOD_MINUTES=30
# MAX_UPLOAD_BYTES=31457280
# SESSION_TTL_HOURS=24
# SCOREBOARD_CACHE_TTL_SECONDS=30
